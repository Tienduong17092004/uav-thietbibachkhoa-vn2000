[Unit]
Description=UAV GeoTIFF WebGPU Survey VN2000 Local Server (https://thietbibachkhoa.id.vn/ -> Port 8765)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/antigravity/UAV_GeoTIFF_WebGPU_Survey_VN2000
Environment="UAV_WEB_PORT=8765"
Environment="UAV_CUSTOM_DOMAIN=thietbibachkhoa.id.vn"
ExecStart=/usr/bin/python3 -m uav_app.adapters.webgpu_public_server --host 0.0.0.0 --port 8765
KillSignal=SIGTERM
TimeoutStopSec=10
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
