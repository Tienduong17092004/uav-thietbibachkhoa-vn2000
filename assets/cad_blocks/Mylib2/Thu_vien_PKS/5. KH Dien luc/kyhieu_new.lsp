(DEFUN Cap-buudien( / P p2)
(COMMAND 'LAYER' 'M' 'THUVIEN' '')
(COMMAND 'INSERT' 'Cap-buudien')
(SETQ P (GETPOINT '\nCho diem chen: '))
(COMMAND P (/ tylebanve 1000.0) (/ tylebanve 1000.0))
)
